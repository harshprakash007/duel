# Copy to .env (repo root) for local development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://duel:duel@localhost:5432/duel
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGIN=http://localhost:5173
# Identify yourself to Codeforces (§17).
CF_USER_AGENT=Duel/0.1 (contact: you@example.com)
# Point at the fake Codeforces server for fully local play: http://localhost:4100/api
CF_BASE_URL=https://codeforces.com/api
CF_MAX_RPS=2
POLL_INTERVAL_MS=5000
# Every other tunable (see apps/api/src/config/index.ts) can be overridden here too.
